# Copy to .env and fill in the password. .env is gitignored: never commit it.
#
#     cp .env.example .env
#
# ── The cloud mirror ─────────────────────────────────────────────────────────
#
# Connect as medilink_app, NOT as postgres. The postgres role can bypass
# row-level security, so using it would silently disable every isolation policy
# on the cloud node while appearing to work perfectly.
#
# Set the password once, from the Supabase SQL editor:
#
#     ALTER ROLE medilink_app WITH PASSWORD 'choose-a-strong-one';
#
# Then put the same password below.
#
# Use the SESSION pooler (port 5432), not the transaction pooler (6543).
# The transaction pooler hands each statement a different backend connection,
# which drops the app.facility_id session variable, and every RLS policy keys
# off that variable. Losing it means a clinic sees zero rows.
#
# Leaving this blank is a SUPPORTED state: the clinics run standalone, queue
# their changes, and drain the queue when a cloud node is configured.
# Get the exact host from: Supabase -> Project Settings -> Database ->
# Connection string -> Session pooler. Replace the user with medilink_app.
CLOUD_DATABASE_URL=postgresql://medilink_app:YOUR_PASSWORD@YOUR_HOST.pooler.supabase.com:5432/postgres

# The schema holding Pulih's tables on the cloud node. Applied at connection
# time in code, not as a URL parameter, because asyncpg does not reliably honour
# ?options= and the queries name tables unqualified.
CLOUD_SCHEMA=medilink
